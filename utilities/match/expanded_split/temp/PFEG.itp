[moleculetype]
; molname      nrexcl
  PFEG          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    P4r   1  PFEG  GL0   1 	0.0
   2     Q5   1  PFEG  PO4   2 	-1.0
   3   SN3a   1  PFEG  ET1   3 	0
   4   SN3a   1  PFEG  ET2   4 	0
   5     C1   1  PFEG  C1A   5 	0
   6    C4h   1  PFEG  D2A   6 	0
   7    C4h   1  PFEG  D3A   7 	0
   8    C4h   1  PFEG  D4A   8 	0
   9    SC1   1  PFEG  C1B   9 	0
  10     C1   1  PFEG  C2B  10 	0
  11     C1   1  PFEG  C3B  11 	0
  12     C1   1  PFEG  C4B  12 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.375	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	3200.0 ; di-alkyl
   3  5 	1 	0.420	2400.0    ; attaching ether linker beads to hydrocarbon tails
   5  6 	1      0.505    2800.0
   6  7 	1      0.460    2800.0    ; containing a double bond in both beads
   7  8 	1      0.470    2800.0
   4  9 	1 	0.345	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   9 10 	1      0.420    4400.0    ; to be used between S to R beads
  10 11 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
  11 12 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	110.0	10.0
   2  3  5 	1	135.0	20.0
   4  3  5 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  4  9 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  5  6 	1	180.0	13.5 ; warning, analog to 1	180.0	13.5
   5  6  7 	1      135.0	8.0    ; second double bond results in different angle distribution
   6  7  8 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
   4  9 10 	1	180.0	13.5 ; ether backbone to tail angle validated on DHPCE and DMPCE
   9 10 11 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
  10 11 12 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference



;;;;;; Martini lipid topology for C16:0/20:2 EG (PIEG), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname PIEG -alhead 'G P' -allink 'E E' -altail 'cCDDC cCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model ether lipid phosphatidylglycerol (EG) lipid corresponding to atomistic C16:0/20:2(11c;14c) 1-palmitoyl-2-eicosadienoyl tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; GL0-PO4-ET1-C1A-C2A-D3A-D4A-C5A
;          |
;         ET2-C1B-C2B-C3B-C4B
;
;  1 - 2 - 3 - 5 - 6 - 7 - 8 - 9 
;          |
;          4 - 10- 11- 12- 13
;
;@INSANE alhead=G P, allink=E E, altail=CCDDC CCCC, alname=PIEG, charge=-1.0
;@RESNTEST PIE==PIEG if: atoms[0]==GL0
;@BEADS GL0 PO4 ET1 ET2 C1A C2A D3A D4A C5A C1B C2B C3B C4B 
;@BONDS GL0-PO4 PO4-ET1 PO4-ET2 ET1-ET2 ET1-C1A C1A-C2A C2A-D3A D3A-D4A D4A-C5A ET2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

