[moleculetype]
; molname      nrexcl
  SOLE          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    Q4p   1  SOLE  NH3   1 	1.0
   2     Q5   1  SOLE  PO4   2 	-1.0
   3   SN4a   1  SOLE  GL1   3 	0
   4  SN4ah   1  SOLE  PL2   4 	0
   5     C1   1  SOLE  C1A   5 	0
   6    C4h   1  SOLE  D2A   6 	0
   7     C1   1  SOLE  C3A   7 	0
   8     C1   1  SOLE  C4A   8 	0
   9     C1   1  SOLE  C1B   9 	0
  10     C1   1  SOLE  C2B  10 	0
  11     C1   1  SOLE  C3B  11 	0
  12     C1   1  SOLE  C4B  12 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.357	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	3200.0 ; alkenyl-acyl (plasmalogens)
   3  5 	1 	0.450	2400.0    ; warning, analog to 1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
   5  6 	1      0.505    2800.0
   6  7 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
   7  8 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   4  9 	1 	0.420	2400.0    ; warning, analog to b_ET_C1_ether_5long
   9 10 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
  10 11 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
  11 12 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	110.0	15.0
   2  3  5 	1	139.0	10.0
   4  3  5 	1	120.0	20.0 ; WARNING acyl-alkenyl (sn1/sn2) not validated
   3  4  9 	1	120.0	20.0 ; alkenyl-acyl plasmalogen backbone to tail angle validated on PLA18 (PC)
   3  5  6 	1	180.0	13.5 ; warning, analog to 1	180.0	13.5
   5  6  7 	1      140.0	10.0   ; one unsaturation
   6  7  8 	1      180.0	13.5   ; identical to a_C1_C1_C1 to improve transition temperatures of singly unsaturated lipids
   4  9 10 	1	180.0	13.5 ; warning, analog to a_ET_C1_C1_ether
   9 10 11 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
  10 11 12 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference



;;;;;; Martini lipid topology for C18:0/18:2 LE (SLLE), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname SLLE -alhead 'E P' -allink 'G L' -altail 'CDDC CCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model plasmalogen phosphatidylethanolamine (LE) lipid corresponding to atomistic C18:0/18:2(9c;12c) 1-stearoyl-2-linoleoyl tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; NH3-PO4-GL1-C1A-D2A-D3A-C4A
;          |
;         PL2-C1B-C2B-C3B-C4B
;
;  1 - 2 - 3 - 5 - 6 - 7 - 8 
;          |
;          4 - 9 - 10- 11- 12
;
;@INSANE alhead=E P, allink=G L, altail=CDDC CCCC, alname=SLLE, charge=0.0
;@RESNTEST SLL==SLLE if: atoms[0]==NH3
;@BEADS NH3 PO4 GL1 PL2 C1A D2A D3A C4A C1B C2B C3B C4B 
;@BONDS NH3-PO4 PO4-GL1 PO4-PL2 GL1-PL2 GL1-C1A C1A-D2A D2A-D3A D3A-C4A PL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

