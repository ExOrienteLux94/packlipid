[moleculetype]
; molname      nrexcl
  IPC          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     Q1   1   IPC  NC3   1 	1.0
   2     Q5   1   IPC  PO4   2 	-1.0
   3   SN4a   1   IPC  GL1   3 	0
   4   SN4a   1   IPC  GL2   4 	0
   5    SC1   1   IPC  C1B   5 	0
   6     C1   1   IPC  C2B   6 	0
   7    C4h   1   IPC  D3B   7 	0
   8    C4h   1   IPC  D4B   8 	0
   9     C1   1   IPC  C5B   9 	0
   
[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.404	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   4  5 	1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   5  6 	1      0.420    4400.0    ; to be used between S to R beads
   6  7 	1      0.475    2800.0    ; containing a double bond in one bead
   7  8 	1      0.460    2800.0    ; containing a double bond in both beads
   8  9 	1      0.485    2800.0

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	125.0	15.0
   3  4  5 	1	120.0	20.0 ; glycerol backbone to tail angle
   5  6  7 	1      180.0	13.5   ; across a beads containing a double bond in the first/third bead
   6  7  8 	1      135.0	8.0    ; second double bond results in different angle distribution
   7  8  9 	1      135.0	8.0
   4  5  6 	1	180.0	13.5

