[moleculetype]
; molname      nrexcl
  PDEE          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    Q4p   1  PDEE  NH3   1 	1.0
   2     Q5   1  PDEE  PO4   2 	-1.0
   3   SN3a   1  PDEE  ET1   3 	0
   4   SN3a   1  PDEE  ET2   4 	0
   5    C4h   1  PDEE  D1A   5 	0
   6    C5h   1  PDEE  D2A   6 	0
   7    C5h   1  PDEE  D3A   7 	0
   8    C4h   1  PDEE  D4A   8 	0
   9    C4h   1  PDEE  D5A   9 	0
  10    SC1   1  PDEE  C1B  10 	0
  11     C1   1  PDEE  C2B  11 	0
  12     C1   1  PDEE  C3B  12 	0
  13     C1   1  PDEE  C4B  13 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.357	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	3200.0 ; di-alkyl
   3  5 	1 	0.405	2400.0    ; attaching ether linker beads to hydrocarbon tail with immediate double bond e.g. 22:6
   5  6 	1      0.490    2800.0
   6  7 	1      0.460    2800.0    ; containing a double bond in both beads
   7  8 	1      0.460    2800.0    ; containing a double bond in both beads
   8  9 	1      0.470    2800.0
   4 10 	1 	0.345	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
  10 11 	1      0.420    4400.0    ; to be used between S to R beads
  11 12 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
  12 13 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	110.0	15.0
   2  3  5 	1	135.0	20.0
   4  3  5 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  4 10 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  5  6 	1	135.0	 8.0 ; warning, analog to 1	135.0	 8.0 ; based on PDPC
   5  6  7 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
   6  7  8 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
   7  8  9 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
   4 10 11 	1	180.0	13.5 ; ether backbone to tail angle validated on DHPCE and DMPCE
  10 11 12 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
  11 12 13 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference



;;;;;; Martini lipid topology for C16:1/18:1 EE (YOEE), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname YOEE -alhead 'E P' -allink 'E E' -altail 'CDCC cCDC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model ether lipid phosphatidylethanolamine (EE) lipid corresponding to atomistic C16:1(9c)/18:1(9c) 1-palmitoleoyl-2-oleoyl tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; NH3-PO4-ET1-C1A-D2A-C3A-C4A
;          |
;         ET2-C1B-C2B-D3B-C4B
;
;  1 - 2 - 3 - 5 - 6 - 7 - 8 
;          |
;          4 - 9 - 10- 11- 12
;
;@INSANE alhead=E P, allink=E E, altail=CDCC CCDC, alname=YOEE, charge=0.0
;@RESNTEST YOE==YOEE if: atoms[0]==NH3
;@BEADS NH3 PO4 ET1 ET2 C1A D2A C3A C4A C1B C2B D3B C4B 
;@BONDS NH3-PO4 PO4-ET1 PO4-ET2 ET1-ET2 ET1-C1A C1A-D2A D2A-C3A C3A-C4A ET2-C1B C1B-C2B C2B-D3B D3B-C4B 
;

