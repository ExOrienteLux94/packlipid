[moleculetype]
MS 	1

[atoms]
; id type   resnr     residu   atom    cgnr charge
1   SP4r  	1 	MS 	DOH 	1  	0
2   SN4a 	1 	MS 	GL1 	2       0
3   C1  	1 	MS 	C1A 	3  	0 ; 5-1 mapping
4   C1	 	1 	MS 	C2A 	4  	0
5   C1  	1 	MS 	C3A 	5  	0
6   C1  	1 	MS 	C4A 	6  	0
		
[bonds]
; i j funct length force.c.
1 2 	1	0.313   4400.0    ; diol in monoglycerides   
2 3 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails    
3 4 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
4 5 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
5 6 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
 1  2  3 	1	132.0	14.0 ; diol in monoglycerides
 2  3  4 	1	180.0	13.5
 3  4  5 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference 
 4  5  6 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference

