[moleculetype]
; molname      nrexcl
  OEEE          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    Q4p   1  OEEE  NH3   1 	1.0
   2     Q5   1  OEEE  PO4   2 	-1.0
   3   SN3a   1  OEEE  ET1   3 	0
   4   SN3a   1  OEEE  ET2   4 	0
   5     C1   1  OEEE  C1A   5 	0
   6     C1   1  OEEE  C2A   6 	0
   7    C4h   1  OEEE  D3A   7 	0
   8     C1   1  OEEE  C4A   8 	0
   9     C1   1  OEEE  C5A   9 	0
  10     C1   1  OEEE  C1B  10 	0
  11    C4h   1  OEEE  D2B  11 	0
  12     C1   1  OEEE  C3B  12 	0
  13     C1   1  OEEE  C4B  13 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.357	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	3200.0 ; di-alkyl
   3  5 	1 	0.420	2400.0    ; attaching ether linker beads to hydrocarbon tails
   5  6 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
   6  7 	1      0.475    2800.0    ; containing a double bond in one bead
   7  8 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
   8  9 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   4 10 	1 	0.420	2400.0    ; attaching ether linker beads to hydrocarbon tails
  10 11 	1      0.505    2800.0
  11 12 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
  12 13 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	110.0	15.0
   2  3  5 	1	135.0	20.0
   4  3  5 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  4 10 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  5  6 	1	180.0	13.5 ; ether backbone to tail angle validated on DHPCE and DMPCE
   5  6  7 	1      180.0	13.5   ; across a beads containing a double bond in the first/third bead
   6  7  8 	1      140.0	10.0   ; one unsaturation
   7  8  9 	1      180.0	13.5   ; identical to a_C1_C1_C1 to improve transition temperatures of singly unsaturated lipids
   4 10 11 	1	180.0	13.5 ; warning, analog to 1	180.0	13.5
  10 11 12 	1      140.0	10.0   ; one unsaturation
  11 12 13 	1      180.0	13.5   ; identical to a_C1_C1_C1 to improve transition temperatures of singly unsaturated lipids



;;;;;; Martini lipid topology for C18:1/22:6 EE (ODEE), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname ODEE -alhead 'E P' -allink 'E E' -altail 'DFFDD CDCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model ether lipid phosphatidylethanolamine (EE) lipid corresponding to atomistic C18:1(9c)/22:6(4c;7c;10c;13c;16c;19c) 1-oleoyl-2-docosahexaenoic acid tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; NH3-PO4-ET1-D1A-D2A-D3A-D4A-D5A
;          |
;         ET2-C1B-D2B-C3B-C4B
;
;  1 - 2 - 3 - 5 - 6 - 7 - 8 - 9 
;          |
;          4 - 10- 11- 12- 13
;
;@INSANE alhead=E P, allink=E E, altail=DDDDD CDCC, alname=ODEE, charge=0.0
;@RESNTEST ODE==ODEE if: atoms[0]==NH3
;@BEADS NH3 PO4 ET1 ET2 D1A D2A D3A D4A D5A C1B D2B C3B C4B 
;@BONDS NH3-PO4 PO4-ET1 PO4-ET2 ET1-ET2 ET1-D1A D1A-D2A D2A-D3A D3A-D4A D4A-D5A ET2-C1B C1B-D2B D2B-C3B C3B-C4B 
;

