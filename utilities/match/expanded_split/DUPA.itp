[moleculetype]
; molname      nrexcl
  DUPA          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     Q5   1  DUPA  PO4   1 	-1.0
   2   SN4a   1  DUPA  GL1   2 	0
   3   SN4a   1  DUPA  GL2   3 	0
   4    SC1   1  DUPA  C1A   4 	0
   5     C1   1  DUPA  C2A   5 	0
   6     C1   1  DUPA  C3A   6 	0
   7    SC1   1  DUPA  C1B   7 	0
   8     C1   1  DUPA  C2B   8 	0
   9     C1   1  DUPA  C3B   9 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.440	1500.0
   1  3 	1 	0.524	1200.0
   2  3 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   2  4 	1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   4  5 	1      0.420    4400.0    ; to be used between S to R beads
   5  6 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   3  7 	1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   7  8 	1      0.420    4400.0    ; to be used between S to R beads
   8  9 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  4 	1	139.0	10.0
   3  2  4 	1	120.0	20.0 ; glycerol backbone to tail angle
   2  3  7 	1	120.0	20.0 ; glycerol backbone to tail angle
   2  4  5 	1	180.0	13.5
   4  5  6 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
   3  7  8 	1	180.0	13.5
   7  8  9 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference



;;;;;; Martini lipid topology for di-C14:0 PA (DMPA), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname DMPA -alhead 'P' -allink 'G G' -altail 'CCC CCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model phosphatidic acid (PA) lipid corresponding to atomistic C14:0 dimyristoyl (DMPA) tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; PO4-GL1-C1A-C2A-C3A
;      |
;     GL2-C1B-C2B-C3B
;
;  1 - 2 - 4 - 5 - 6 
;      |
;      3 - 7 - 8 - 9 
;
;@INSANE alhead=P, allink=G G, altail=CCC CCC, alname=DMPA, charge=-1.0
;@RESNTEST DMP==DMPA if: atoms[0]==PO4
;@BEADS PO4 GL1 GL2 C1A C2A C3A C1B C2B C3B 
;@BONDS PO4-GL1 PO4-GL2 GL1-GL2 GL1-C1A C1A-C2A C2A-C3A GL2-C1B C1B-C2B C2B-C3B 
;

