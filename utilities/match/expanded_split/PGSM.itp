[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.404	7000.0
   2  3 	1 	0.380	6000.0
   2  4 	1 	0.490	6000.0
   3  4 	1 	0.305  20000.0
   3  5 	1 	0.345  20000.0
   5  6 	1      0.405    4400.0    ; symmetric to b_SC1_C4_mid
   6  7 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
   7  8 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   4  9 	1 	0.405	2400.0
   9 10 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
  10 11 	1      0.475    2800.0    ; containing a double bond in one bead
  11 12 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
  12 13 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
  
[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
