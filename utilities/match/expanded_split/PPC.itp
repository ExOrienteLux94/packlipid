[moleculetype]
; molname      nrexcl
  PPC          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     Q1   1   PPC  NC3   1 	1.0
   2     Q5   1   PPC  PO4   2 	-1.0
   3   SN4a   1   PPC  GL1   3 	0
   4   SN4a   1   PPC  GL2   4 	0
   5    SC1   1   PPC  C1B   5 	0
   6     C1   1   PPC  C2B   6 	0
   7     C1   1   PPC  C3B   7 	0
   8     C1   1   PPC  C4B   8 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.404	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   4  5 	1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   5  6 	1      0.420    4400.0    ; to be used between S to R beads
   6  7 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
   7  8 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	125.0	15.0
   3  4  5 	1	120.0	20.0 ; glycerol backbone to tail angle
   4  5  6 	1	180.0	13.5
   5  6  7 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
   6  7  8 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
   
