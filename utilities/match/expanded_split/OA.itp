[moleculetype]
OA 	1

[atoms]
; id type   resnr     residu   atom    cgnr charge
1   SQ5n 	1 	OA 	COO 	1      -1.0
2   C1  	1 	OA 	C1A 	2  	0 ; 5-1 mapping
3   C4h 	1 	OA 	D2A 	3  	0
4   C1  	1 	OA 	C3A 	4  	0
5   C1  	1 	OA 	C4A 	5  	0
		
[bonds]
; i j funct length force.c.
1 2 	1 	0.400	2800.0    
2 3 	1      0.505    2800.0
3 4 	1      0.475    2800.0    ; containing a double bond in one bead
4 5 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
 1  2  3 	1	180.0	13.5
 2  3  4 	1      140.0	10.0   ; one unsaturation 
 3  4  5 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference

