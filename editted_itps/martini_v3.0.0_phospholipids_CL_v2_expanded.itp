;;;;; 
;;;;; Tetramyristyoyl cardiolipin 
;;;;; TMCL
;;;;; 

[ moleculetype ]
; molname  nrexcl
  TMCL     1 

[ atoms ]
; i type resnr residue atom cgnr charge
  1 N6   1     TMCL    GLC   1    0.0 ; linking bead
  2 Q5   1     TMCL    PO41  2   -1.0 ; first phosphatidyl group
