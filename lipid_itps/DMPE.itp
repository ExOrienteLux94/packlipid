[moleculetype]
; molname      nrexcl
  DMPE          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    Q4p   1  DMPE  NH3   1 	1.0
   2     Q5   1  DMPE  PO4   2 	-1.0
   3   SN4a   1  DMPE  GL1   3 	0
   4   SN4a   1  DMPE  GL2   4 	0
   5     C1   1  DMPE  C1A   5 	0
   6     C1   1  DMPE  C2A   6 	0
   7     C1   1  DMPE  C3A   7 	0
   8     C1   1  DMPE  C1B   8 	0
   9     C1   1  DMPE  C2B   9 	0
  10     C1   1  DMPE  C3B  10 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.357	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   3  5 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
   5  6 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
   6  7 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   4  8 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
   8  9 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
   9 10 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	110.0	15.0
   2  3  5 	1	139.0	10.0
   4  3  5 	1	120.0	20.0 ; glycerol backbone to tail angle
   3  4  8 	1	120.0	20.0 ; glycerol backbone to tail angle
   3  5  6 	1	180.0	13.5
   5  6  7 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
   4  8  9 	1	180.0	13.5
   8  9 10 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference



;;;;;; Martini lipid topology for di-C16:0 PE (DPPE), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname DPPE -alhead 'E P' -allink 'G G' -altail 'cCCC cCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model phosphatidylethanolamine (PE) lipid corresponding to atomistic C16:0 dipalmitoyl (DPPE) tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; NH3-PO4-GL1-C1A-C2A-C3A-C4A
;          |
;         GL2-C1B-C2B-C3B-C4B
;
;  1 - 2 - 3 - 5 - 6 - 7 - 8 
;          |
;          4 - 9 - 10- 11- 12
;
;@INSANE alhead=E P, allink=G G, altail=CCCC CCCC, alname=DPPE, charge=0.0
;@RESNTEST DPP==DPPE if: atoms[0]==NH3
;@BEADS NH3 PO4 GL1 GL2 C1A C2A C3A C4A C1B C2B C3B C4B 
;@BONDS NH3-PO4 PO4-GL1 PO4-GL2 GL1-GL2 GL1-C1A C1A-C2A C2A-C3A C3A-C4A GL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

