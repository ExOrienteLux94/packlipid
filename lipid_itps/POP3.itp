[moleculetype]
; molname      nrexcl
  POP3          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    SP1   1  POP3   C1   1 	0
   2    SP1   1  POP3   C2   2 	0
   3   SN4a   1  POP3   C3   3 	0
   4    TC4   1  POP3   C4   4 	0 	0 	; Massless virtual bead
   5     Q5   1  POP3  PO4   5 	-1.0
   6     Q5   1  POP3   P3   6 	-1.3
   7      D   1  POP3   P4   7 	-1.4
   8     Q5   1  POP3   P5   8 	-1.3
   9   SN4a   1  POP3  GL1   9 	0
  10   SN4a   1  POP3  GL2  10 	0
  11     C1   1  POP3  C1A  11 	0
  12    C4h   1  POP3  D2A  12 	0
  13     C1   1  POP3  C3A  13 	0
  14     C1   1  POP3  C4A  14 	0
  15    SC1   1  POP3  C1B  15 	0
  16     C1   1  POP3  C2B  16 	0
  17     C1   1  POP3  C3B  17 	0
  18     C1   1  POP3  C4B  18 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
#ifdef FLEXIBLE
; Using bonds not constraints
   1  2   1 	0.290 	30000
   1  3   1 	0.284 	30000
   2  3   1 	0.307 	30000
#endif
; Headgroup phosphates
   6  3   1 	0.306 	7500 	; P3 C3
   6  1   1 	0.505 	1250 	; P3 C3
   7  3   1 	0.325 	5500 	; P4 C3
   8  2   1 	0.395 	3500 	; P5 C2
   8  1   1 	0.500 	1250 	; P5 C1
   7  8   1 	0.505 	800 	; P4 P5
; Phosphodiester and glycerol backbone
   1  5   1 	0.341 	5000 	; C1 PO4
   5  9   1 	0.36  	2000 	; PO4 GL1
   5 10   1 	0.51  	 900 	; PO4 GL2
; Lipid tail (uses standard Martini tail rules)
   9 10 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   9 11 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
  11 12 	1      0.505    2800.0
  12 13 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
  13 14 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
  10 15 	1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
  15 16 	1      0.420    4400.0    ; to be used between S to R beads
  16 17 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
  17 18 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
; Orient the headgroup
   2  1  5  10 	105.0 	17.5 	; C2 C1 PO4
   1  5  9  10 	 90.0 	 3.5 	; C1 PO4 GL1
   6  3  1  10 	110.0 	10.0 	; P3 C3 C1
   7  3  2  10 	 95.0 	 2.0 	; P4 C3 C2
   8  2  3  10 	110.0 	20.0 	; P5 C2 C3
; Tail part (uses standard Martini tail rules)
  10  9 11 	1	120.0	20.0 ; glycerol backbone to tail angle
   9 10 15 	1	120.0	20.0 ; glycerol backbone to tail angle
   9 11 12 	1	180.0	13.5
  11 12 13 	1      140.0	10.0   ; one unsaturation
  12 13 14 	1      180.0	13.5   ; identical to a_C1_C1_C1 to improve transition temperatures of singly unsaturated lipids
  10 15 16 	1	180.0	13.5
  15 16 17 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
  16 17 18 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference

[dihedrals]
;  i  j  k  l 	name 	(using named dihedraltypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k  l 	funct 	angle 	force.c.
; Orient the headgroup
   3  2  1  5   2 	-180 	0.5 	 	; C3 C2 C1 PO4
   2  1  5  9   1 	180 	1.5 	2 	; C2 C1 PO4 GL1
   6  3  1  2   2 	130 	10.0 	 	; P3 C3 C1 C2
   7  3  2  1   2 	130 	15.0 	 	; P4 C3 C2 C1
   8  2  3  1   2 	115 	17.5 	 	; P5 C2 C3 C1

[constraints]
;  i  j  k 	funct 	length
#ifndef FLEXIBLE
; Using constraints not bonds
   1  2 	1 	0.290 	; C1 C2
   1  3 	1 	0.284 	; C1 C3
   2  3 	1 	0.307 	; C2 C3
#endif

[ virtual_sitesn ]
; site funct  constructing atom indices
   4     2     1 2 3

[exclusions]
; i  j  k  ...
  4 3 2 1 5 6 7 8
  3 2 1
  2 1



;;;;;; Martini lipid topology for C18:0/20:4 PIP3(3,4,5) (SAP3), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname SAP3 -alhead 'P3' -allink 'G G' -altail 'cFFDC CCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model phosphatidylinositol trisphosphate (PIP3(3,4,5)) lipid corresponding to atomistic C18:0/20:4 1-stearoyl-2-arachidonoyl tails.
; Parameterization:
;   The lipid head parameters are based on referance atomistic CHARMM36m simulations, see Borges-Araujo et al. 2021 for details. 
;   The lipid tail follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Tail bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
;   L. Borges-Araujo, P.C.T. Souza, F. Fernandes and M.N. Melo. Improved Parameterization of Phosphatidylinositide 
;   Lipid Headgroups for the Martini 3 Coarse-Grain Force Field, JCTC, 2021. doi:10.1021/acs.jctc.1c00615 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; GL1-C1A-D2A-D3A-D4A-C5A
;  |
; GL2-C1B-C2B-C3B-C4B
;
;  9 - 11- 12- 13- 14- 15
;  |
;  10- 16- 17- 18- 19
;
;@INSANE alhead=P3, allink=G G, altail=CDDDC CCCC, alname=SAP3, charge=-5.0
;@RESNTEST SAP==SAP3 if: atoms[0]==C1 and atoms[6]==P3
;@BEADS C1 C2 C3 C4 PO4 P3 P4 P5 GL1 GL2 C1A D2A D3A D4A C5A C1B C2B C3B C4B 
;@BONDS C1-C2 C1-C3 C2-C3 P3-C3 P3-C1 P4-C3 P5-C2 P5-C1 P4-P5 C1-PO4 PO4-GL1 PO4-GL2 GL1-GL2 GL1-C1A C1A-D2A D2A-D3A D3A-D4A D4A-C5A GL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

