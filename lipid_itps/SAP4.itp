[moleculetype]
; molname      nrexcl
  SAP4          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    SP1   1  SAP4   C1   1 	0
   2   SP4r   1  SAP4   C2   2 	0
   3    SP1   1  SAP4   C3   3 	0
   4    TC4   1  SAP4   C4   4 	0 	0 	; Massless virtual bead
   5     Q5   1  SAP4  PO4   5 	-1.0
   6      D   1  SAP4   P4   6 	-2.0
   7   SN4a   1  SAP4  GL1   7 	0
   8   SN4a   1  SAP4  GL2   8 	0
   9    SC1   1  SAP4  C1A   9 	0
  10    C5h   1  SAP4  D2A  10 	0
  11    C5h   1  SAP4  D3A  11 	0
  12    C4h   1  SAP4  D4A  12 	0
  13     C1   1  SAP4  C5A  13 	0
  14     C1   1  SAP4  C1B  14 	0
  15     C1   1  SAP4  C2B  15 	0
  16     C1   1  SAP4  C3B  16 	0
  17     C1   1  SAP4  C4B  17 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
#ifdef FLEXIBLE
; Using bonds not constraints
   1  2   1 	0.3037 	30000
   1  3   1 	0.2945 	30000
   2  3   1 	0.3370 	30000
#endif
; Headgroup phosphates
   6  3   1 	0.325 	5250 	; P4 C3
; Phosphodiester and glycerol backbone
   1  5   1 	0.335 	5500 	; C1 PO4
   5  7   1 	0.36  	2250 	; PO4 GL1
   5  8   1 	0.52  	 800 	; PO4 GL2
; Lipid tail (uses standard Martini tail rules)
   7  8 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   7  9 	1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   9 10 	1      0.405    4400.0
  10 11 	1      0.460    2800.0    ; containing a double bond in both beads
  11 12 	1      0.460    2800.0    ; containing a double bond in both beads
  12 13 	1      0.485    2800.0
   8 14 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
  14 15 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
  15 16 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
  16 17 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
; Orient the headgroup
   2  1  5  10 	98.0 	27.5 	; C2  C1 PO4
   1  5  7  10 	90.0 	 3.0 	; C1 PO4 GL1
   6  3  2  10 	92.0 	55.0 	; P4 C3 C2
; Tail part (uses standard Martini tail rules)
   8  7  9 	1	120.0	20.0 ; glycerol backbone to tail angle
   7  8 14 	1	120.0	20.0 ; glycerol backbone to tail angle
   7  9 10 	1	180.0	13.5
   9 10 11 	1      135.0	8.0    ; second double bond results in different angle distribution
  10 11 12 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
  11 12 13 	1      135.0	8.0
   8 14 15 	1	180.0	13.5
  14 15 16 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
  15 16 17 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference

[dihedrals]
;  i  j  k  l 	name 	(using named dihedraltypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k  l 	funct 	angle 	force.c.
; Orient the headgroup
   3  2  1  5   2 	-145 	130.0 	 	; C3 C2 C1 PO4
   2  1  5  7   1 	180 	2.0 	2 	; C3 C2 C1 PO4
   6  3  2  1   2 	-170 	110.0 	 	; P4 C3 C2 C1

[constraints]
;  i  j  k 	funct 	length
#ifndef FLEXIBLE
; Using constraints not bonds
   1  2 	1 	0.3037 	; C1 C2
   1  3 	1 	0.2945 	; C1 C3
   2  3 	1 	0.3370 	; C2 C3
#endif

[ virtual_sitesn ]
; site funct  constructing atom indices
   4     2     1 2 3

[exclusions]
; i  j  k  ...
  4 3 2 1 5 6
  3 2 1
  2 1


; P1_5 -> SA - Phosphatidylinositol 5-phosphate - here called P5
;
;        P5
;        |
;       C2 — — — C3
;         \  C4  /
;          \    /
;            C1
;            |
;          PO4
;         /  |
;      GL2 - GL1
;      |     |
;   ChainA  ChainB
;


;;;;;; Martini lipid topology for C16:0/18:1 PIP1(5) (POP5), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname POP5 -alhead 'P5' -allink 'G G' -altail 'CDCC cCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model phosphatidylinositol phosphate (PIP1(5)) lipid corresponding to atomistic C16:0/18:1 1-palmitoyl-2-oleoyl (PO-PIP1(5)) tails.
; Parameterization:
;   The lipid head parameters are based on referance atomistic CHARMM36m simulations, see Borges-Araujo et al. 2021 for details. 
;   The lipid tail follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Tail bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
;   L. Borges-Araujo, P.C.T. Souza, F. Fernandes and M.N. Melo. Improved Parameterization of Phosphatidylinositide 
;   Lipid Headgroups for the Martini 3 Coarse-Grain Force Field, JCTC, 2021. doi:10.1021/acs.jctc.1c00615 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; GL1-C1A-D2A-C3A-C4A
;  |
; GL2-C1B-C2B-C3B-C4B
;
;  7 - 9 - 10- 11- 12
;  |
;  8 - 13- 14- 15- 16
;
;@INSANE alhead=P5, allink=G G, altail=CDCC CCCC, alname=POP5, charge=-3.0
;@RESNTEST POP==POP5 if: atoms[0]==C1
;@BEADS C1 C2 C3 C4 PO4 P5 GL1 GL2 C1A D2A C3A C4A C1B C2B C3B C4B 
;@BONDS C1-C2 C1-C3 C2-C3 P5-C2 C1-PO4 PO4-GL1 PO4-GL2 GL1-GL2 GL1-C1A C1A-D2A D2A-C3A C3A-C4A GL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

