[moleculetype]
; molname      nrexcl
  DBEA          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     Q5   1  DBEA  PO4   1 	-1.0
   2   SN3a   1  DBEA  ET1   2 	0
   3   SN3a   1  DBEA  ET2   3 	0
   4     C1   1  DBEA  C1A   4 	0
   5     C1   1  DBEA  C2A   5 	0
   6     C1   1  DBEA  C3A   6 	0
   7     C1   1  DBEA  C4A   7 	0
   8     C1   1  DBEA  C5A   8 	0
   9     C1   1  DBEA  C1B   9 	0
  10     C1   1  DBEA  C2B  10 	0
  11     C1   1  DBEA  C3B  11 	0
  12     C1   1  DBEA  C4B  12 	0
  13     C1   1  DBEA  C5B  13 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.440	1500.0
   1  3 	1 	0.524	1200.0
   2  3 	1 	0.315	3200.0 ; di-alkyl
   2  4 	1 	0.420	2400.0    ; attaching ether linker beads to hydrocarbon tails
   4  5 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
   5  6 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
   6  7 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
   7  8 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   3  9 	1 	0.420	2400.0    ; attaching ether linker beads to hydrocarbon tails
   9 10 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
  10 11 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
  11 12 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
  12 13 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  4 	1	135.0	20.0
   3  2  4 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   2  3  9 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   2  4  5 	1	180.0	13.5 ; ether backbone to tail angle validated on DHPCE and DMPCE
   4  5  6 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
   5  6  7 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
   6  7  8 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
   3  9 10 	1	180.0	13.5 ; ether backbone to tail angle validated on DHPCE and DMPCE
   9 10 11 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
  10 11 12 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
  11 12 13 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference



;;;;;; Martini lipid topology for di-C24:0 EA (DXEA), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname DXEA -alhead 'P' -allink 'E E' -altail 'cCCCCC cCCCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model ether lipid phosphatidic acid (EA) lipid corresponding to atomistic C24:0 dilignoceroyl tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; PO4-ET1-C1A-C2A-C3A-C4A-C5A-C6A
;      |
;     ET2-C1B-C2B-C3B-C4B-C5B-C6B
;
;  1 - 2 - 4 - 5 - 6 - 7 - 8 - 9 
;      |
;      3 - 10- 11- 12- 13- 14- 15
;
;@INSANE alhead=P, allink=E E, altail=CCCCCC CCCCCC, alname=DXEA, charge=-1.0
;@RESNTEST DXE==DXEA if: atoms[0]==PO4
;@BEADS PO4 ET1 ET2 C1A C2A C3A C4A C5A C6A C1B C2B C3B C4B C5B C6B 
;@BONDS PO4-ET1 PO4-ET2 ET1-ET2 ET1-C1A C1A-C2A C2A-C3A C3A-C4A C4A-C5A C5A-C6A ET2-C1B C1B-C2B C2B-C3B C3B-C4B C4B-C5B C5B-C6B 
;

