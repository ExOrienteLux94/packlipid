[moleculetype]
; molname      nrexcl
  DJPG          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    P4r   1  DJPG  GL0   1 	0.0
   2     Q5   1  DJPG  PO4   2 	-1.0
   3   SN4a   1  DJPG  GL1   3 	0
   4   SN4a   1  DJPG  GL2   4 	0
   5     C1   1  DJPG  C1A   5 	0
   6     C1   1  DJPG  C2A   6 	0
   7     C1   1  DJPG  C1B   7 	0
   8     C1   1  DJPG  C2B   8 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.375	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   3  5 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
   5  6 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
   4  7 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
   7  8 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	110.0	10.0
   2  3  5 	1	139.0	10.0
   4  3  5 	1	120.0	20.0 ; glycerol backbone to tail angle
   3  4  7 	1	120.0	20.0 ; glycerol backbone to tail angle
   3  5  6 	1	180.0	13.5
   4  7  8 	1	180.0	13.5



;;;;;; Martini lipid topology for di-C12:0 PG (DUPG), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname DUPG -alhead 'G P' -allink 'G G' -altail 'cCC cCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model phosphatidylglycerol (PG) lipid corresponding to atomistic C12:0 dilauroyl tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; GL0-PO4-GL1-C1A-C2A-C3A
;          |
;         GL2-C1B-C2B-C3B
;
;  1 - 2 - 3 - 5 - 6 - 7 
;          |
;          4 - 8 - 9 - 10
;
;@INSANE alhead=G P, allink=G G, altail=CCC CCC, alname=DUPG, charge=-1.0
;@RESNTEST DUP==DUPG if: atoms[0]==GL0
;@BEADS GL0 PO4 GL1 GL2 C1A C2A C3A C1B C2B C3B 
;@BONDS GL0-PO4 PO4-GL1 PO4-GL2 GL1-GL2 GL1-C1A C1A-C2A C2A-C3A GL2-C1B C1B-C2B C2B-C3B 
;

