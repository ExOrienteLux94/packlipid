[moleculetype]
; molname      nrexcl
  SALA          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     Q5   1  SALA  PO4   1 	-1.0
   2   SN4a   1  SALA  GL1   2 	0
   3  SN4ah   1  SALA  PL2   3 	0
   4    SC1   1  SALA  C1A   4 	0
   5    C5h   1  SALA  D2A   5 	0
   6    C5h   1  SALA  D3A   6 	0
   7    C4h   1  SALA  D4A   7 	0
   8     C1   1  SALA  C5A   8 	0
   9     C1   1  SALA  C1B   9 	0
  10     C1   1  SALA  C2B  10 	0
  11     C1   1  SALA  C3B  11 	0
  12     C1   1  SALA  C4B  12 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.440	1500.0
   1  3 	1 	0.524	1200.0
   2  3 	1 	0.315	3200.0 ; alkenyl-acyl (plasmalogens)
   2  4 	1 	0.375	4400.0    ; warning, analog to 1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   4  5 	1      0.405    4400.0
   5  6 	1      0.460    2800.0    ; containing a double bond in both beads
   6  7 	1      0.460    2800.0    ; containing a double bond in both beads
   7  8 	1      0.485    2800.0
   3  9 	1 	0.420	2400.0    ; warning, analog to b_ET_C1_ether_5long
   9 10 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
  10 11 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
  11 12 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  4 	1	139.0	10.0
   3  2  4 	1	120.0	20.0 ; WARNING acyl-alkenyl (sn1/sn2) not validated
   2  3  9 	1	120.0	20.0 ; alkenyl-acyl plasmalogen backbone to tail angle validated on PLA18 (PC)
   2  4  5 	1	180.0	13.5 ; warning, analog to 1	180.0	13.5
   4  5  6 	1      135.0	8.0    ; second double bond results in different angle distribution
   5  6  7 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
   6  7  8 	1      135.0	8.0
   3  9 10 	1	180.0	13.5 ; warning, analog to a_ET_C1_C1_ether
   9 10 11 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
  10 11 12 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference



;;;;;; Martini lipid topology for C18:0/22:6 LA (SDLA), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname SDLA -alhead 'P' -allink 'G L' -altail 'DFFDD CCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model plasmalogen phosphatidic acid (LA) lipid corresponding to atomistic C18:0/22:6(4c;7c;10c;13c;16c;19c) 1-stearoyl-2-docosahexaenoyl tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; PO4-GL1-D1A-D2A-D3A-D4A-D5A
;      |
;     PL2-C1B-C2B-C3B-C4B
;
;  1 - 2 - 4 - 5 - 6 - 7 - 8 
;      |
;      3 - 9 - 10- 11- 12
;
;@INSANE alhead=P, allink=G L, altail=DDDDD CCCC, alname=SDLA, charge=-1.0
;@RESNTEST SDL==SDLA if: atoms[0]==PO4
;@BEADS PO4 GL1 PL2 D1A D2A D3A D4A D5A C1B C2B C3B C4B 
;@BONDS PO4-GL1 PO4-PL2 GL1-PL2 GL1-D1A D1A-D2A D2A-D3A D3A-D4A D4A-D5A PL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

