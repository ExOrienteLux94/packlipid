[moleculetype]
; molname      nrexcl
  YOES          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     P6   1  YOES  CNO   1 	0.0
   2     Q5   1  YOES  PO4   2 	-1.0
   3   SN3a   1  YOES  ET1   3 	0
   4   SN3a   1  YOES  ET2   4 	0
   5     C1   1  YOES  C1A   5 	0
   6    C4h   1  YOES  D2A   6 	0
   7     C1   1  YOES  C3A   7 	0
   8     C1   1  YOES  C4A   8 	0
   9    SC1   1  YOES  C1B   9 	0
  10     C1   1  YOES  C2B  10 	0
  11    C4h   1  YOES  D3B  11 	0
  12     C1   1  YOES  C4B  12 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.388	8000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	3200.0 ; di-alkyl
   3  5 	1 	0.420	2400.0    ; attaching ether linker beads to hydrocarbon tails
   5  6 	1      0.505    2800.0
   6  7 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
   7  8 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   4  9 	1 	0.345	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   9 10 	1      0.420    4400.0    ; to be used between S to R beads
  10 11 	1      0.475    2800.0    ; containing a double bond in one bead
  11 12 	1      0.485    2800.0

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	115.0	17.5
   2  3  5 	1	135.0	20.0
   4  3  5 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  4  9 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  5  6 	1	180.0	13.5 ; warning, analog to 1	180.0	13.5
   5  6  7 	1      140.0	10.0   ; one unsaturation
   6  7  8 	1      180.0	13.5   ; identical to a_C1_C1_C1 to improve transition temperatures of singly unsaturated lipids
   4  9 10 	1	180.0	13.5 ; ether backbone to tail angle validated on DHPCE and DMPCE
   9 10 11 	1      180.0	13.5   ; across a beads containing a double bond in the first/third bead
  10 11 12 	1      140.0	10.0   ; one unsaturation



;;;;;; Martini lipid topology for C18:0/18:1 ES (SOES), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname SOES -alhead 'S P' -allink 'E E' -altail 'CDCC CCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model ether lipid phosphatidylserine (ES) lipid corresponding to atomistic C18:0/18:1(9c) 1-stearoyl-2-oleoyl (SOES) tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; CNO-PO4-ET1-C1A-D2A-C3A-C4A
;          |
;         ET2-C1B-C2B-C3B-C4B
;
;  1 - 2 - 3 - 5 - 6 - 7 - 8 
;          |
;          4 - 9 - 10- 11- 12
;
;@INSANE alhead=S P, allink=E E, altail=CDCC CCCC, alname=SOES, charge=-1.0
;@RESNTEST SOE==SOES if: atoms[0]==CNO
;@BEADS CNO PO4 ET1 ET2 C1A D2A C3A C4A C1B C2B C3B C4B 
;@BONDS CNO-PO4 PO4-ET1 PO4-ET2 ET1-ET2 ET1-C1A C1A-D2A D2A-C3A C3A-C4A ET2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

