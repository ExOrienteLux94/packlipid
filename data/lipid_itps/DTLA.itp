[moleculetype]
; molname      nrexcl
  DTLA          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     Q5   1  DTLA  PO4   1 	-1.0
   2   SN4a   1  DTLA  GL1   2 	0
   3  SN4ah   1  DTLA  PL2   3 	0
   4    SC1   1  DTLA  C1A   4 	0
   5     C1   1  DTLA  C2A   5 	0
   6    SC1   1  DTLA  C1B   6 	0
   7     C1   1  DTLA  C2B   7 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.440	1500.0
   1  3 	1 	0.524	1200.0
   2  3 	1 	0.315	3200.0 ; alkenyl-acyl (plasmalogens)
   2  4 	1 	0.375	4400.0    ; warning, analog to 1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   4  5 	1      0.430    4400.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   3  6 	1 	0.345	4400.0    ; warning, analog to b_ET_SC1_ether
   6  7 	1      0.430    4400.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  4 	1	139.0	10.0
   3  2  4 	1	120.0	20.0 ; WARNING acyl-alkenyl (sn1/sn2) not validated
   2  3  6 	1	120.0	20.0 ; alkenyl-acyl plasmalogen backbone to tail angle validated on PLA18 (PC)
   2  4  5 	1	180.0	13.5 ; warning, analog to 1	180.0	13.5
   3  6  7 	1	180.0	13.5 ; warning, analog to a_ET_C1_C1_ether



;;;;;; Martini lipid topology for di-C10:0 LA (DJLA), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname DJLA -alhead 'P' -allink 'G L' -altail 'CC CC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model plasmalogen phosphatidic acid (LA) lipid corresponding to atomistic C10:0 didecanoyl tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; PO4-GL1-C1A-C2A
;      |
;     PL2-C1B-C2B
;
;  1 - 2 - 4 - 5 
;      |
;      3 - 6 - 7 
;
;@INSANE alhead=P, allink=G L, altail=CC CC, alname=DJLA, charge=-1.0
;@RESNTEST DJL==DJLA if: atoms[0]==PO4
;@BEADS PO4 GL1 PL2 C1A C2A C1B C2B 
;@BONDS PO4-GL1 PO4-PL2 GL1-PL2 GL1-C1A C1A-C2A PL2-C1B C1B-C2B 
;

