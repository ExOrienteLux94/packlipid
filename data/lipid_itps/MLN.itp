3 4 	1      0.505    2800.0
4 5 	1      0.460    2800.0    ; containing a double bond in both beads
5 6 	1      0.460    2800.0    ; containing a double bond in both beads

[angles]
 1  2  3 	1	132.0	14.0 ; diol in monoglycerides
 2  3  4 	1	180.0	13.5
 3  4  5 	1      135.0	8.0    ; second double bond results in different angle distribution 
