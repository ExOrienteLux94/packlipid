[moleculetype]
; molname      nrexcl
  PEPA          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     Q5   1  PEPA  PO4   1 	-1.0
   2   SN4a   1  PEPA  GL1   2 	0
   3   SN4a   1  PEPA  GL2   3 	0
   4     C1   1  PEPA  C1A   4 	0
   5     C1   1  PEPA  C2A   5 	0
   6    C4h   1  PEPA  D3A   6 	0
   7     C1   1  PEPA  C4A   7 	0
   8     C1   1  PEPA  C5A   8 	0
   9    SC1   1  PEPA  C1B   9 	0
  10     C1   1  PEPA  C2B  10 	0
  11     C1   1  PEPA  C3B  11 	0
  12     C1   1  PEPA  C4B  12 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.440	1500.0
   1  3 	1 	0.524	1200.0
   2  3 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   2  4 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
   4  5 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
   5  6 	1      0.475    2800.0    ; containing a double bond in one bead
   6  7 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
   7  8 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   3  9 	1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   9 10 	1      0.420    4400.0    ; to be used between S to R beads
  10 11 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
  11 12 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  4 	1	139.0	10.0
   3  2  4 	1	120.0	20.0 ; glycerol backbone to tail angle
   2  3  9 	1	120.0	20.0 ; glycerol backbone to tail angle
   2  4  5 	1	180.0	13.5
   4  5  6 	1      180.0	13.5   ; across a beads containing a double bond in the first/third bead
   5  6  7 	1      140.0	10.0   ; one unsaturation
   6  7  8 	1      180.0	13.5   ; identical to a_C1_C1_C1 to improve transition temperatures of singly unsaturated lipids
   3  9 10 	1	180.0	13.5
   9 10 11 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
  10 11 12 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference



;;;;;; Martini lipid topology for C16:0/22:6 PA (PDPA), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname PDPA -alhead 'P' -allink 'G G' -altail 'DFFDD cCCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model phosphatidic acid (PA) lipid corresponding to atomistic C16:0/22:6(4c;7c;10c;13c;16c;19c) 1-palmitoyl-2-docosahexaenoyl tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; PO4-GL1-D1A-D2A-D3A-D4A-D5A
;      |
;     GL2-C1B-C2B-C3B-C4B
;
;  1 - 2 - 4 - 5 - 6 - 7 - 8 
;      |
;      3 - 9 - 10- 11- 12
;
;@INSANE alhead=P, allink=G G, altail=DDDDD CCCC, alname=PDPA, charge=-1.0
;@RESNTEST PDP==PDPA if: atoms[0]==PO4
;@BEADS PO4 GL1 GL2 D1A D2A D3A D4A D5A C1B C2B C3B C4B 
;@BONDS PO4-GL1 PO4-GL2 GL1-GL2 GL1-D1A D1A-D2A D2A-D3A D3A-D4A D4A-D5A GL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;

