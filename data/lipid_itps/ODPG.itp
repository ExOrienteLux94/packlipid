[moleculetype]
; molname      nrexcl
  ODPG          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1    P4r   1  ODPG  GL0   1 	0.0
   2     Q5   1  ODPG  PO4   2 	-1.0
   3   SN4a   1  ODPG  GL1   3 	0
   4   SN4a   1  ODPG  GL2   4 	0
   5    C4h   1  ODPG  D1A   5 	0
   6    C5h   1  ODPG  D2A   6 	0
   7    C5h   1  ODPG  D3A   7 	0
   8    C4h   1  ODPG  D4A   8 	0
   9    C4h   1  ODPG  D5A   9 	0
  10     C1   1  ODPG  C1B  10 	0
  11    C4h   1  ODPG  D2B  11 	0
  12     C1   1  ODPG  C3B  12 	0
  13     C1   1  ODPG  C4B  13 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.375	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   3  5 	1 	0.435	2400.0    ; attaching glycerol+ester beads to hydrocarbon tail with immediate double bond e.g. 22:6
   5  6 	1      0.490    2800.0
   6  7 	1      0.460    2800.0    ; containing a double bond in both beads
   7  8 	1      0.460    2800.0    ; containing a double bond in both beads
   8  9 	1      0.470    2800.0
   4 10 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
  10 11 	1      0.505    2800.0
  11 12 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
  12 13 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	110.0	10.0
   2  3  5 	1	139.0	10.0
   4  3  5 	1	120.0	20.0 ; glycerol backbone to tail angle
   3  4 10 	1	120.0	20.0 ; glycerol backbone to tail angle
   3  5  6 	1	135.0	 8.0 ; based on PDPC
   5  6  7 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
   6  7  8 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
   7  8  9 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
   4 10 11 	1	180.0	13.5
  10 11 12 	1      140.0	10.0   ; one unsaturation
  11 12 13 	1      180.0	13.5   ; identical to a_C1_C1_C1 to improve transition temperatures of singly unsaturated lipids



;;;;;; Martini lipid topology for C18:2/18:3 PG (LFPG), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname LFPG -alhead 'G P' -allink 'G G' -altail 'CDDD CDDC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model phosphatidylglycerol (PG) lipid corresponding to atomistic C18:2(9c;12c)/18:3(9c;12c;15c) 1-dilinoleoyl-2-alpha-linolenic acid  tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; GL0-PO4-GL1-C1A-D2A-D3A-D4A
;          |
;         GL2-C1B-D2B-D3B-C4B
;
;  1 - 2 - 3 - 5 - 6 - 7 - 8 
;          |
;          4 - 9 - 10- 11- 12
;
;@INSANE alhead=G P, allink=G G, altail=CDDD CDDC, alname=LFPG, charge=-1.0
;@RESNTEST LFP==LFPG if: atoms[0]==GL0
;@BEADS GL0 PO4 GL1 GL2 C1A D2A D3A D4A C1B D2B D3B C4B 
;@BONDS GL0-PO4 PO4-GL1 PO4-GL2 GL1-GL2 GL1-C1A C1A-D2A D2A-D3A D3A-D4A GL2-C1B C1B-D2B D2B-D3B D3B-C4B 
;

