  12    C5h   1  DAES  D3B  12 	0
  13    C4h   1  DAES  D4B  13 	0
  14     C1   1  DAES  C5B  14 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.388	8000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	3200.0 ; di-alkyl
   3  5 	1 	0.345	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   5  6 	1      0.405    4400.0
   6  7 	1      0.460    2800.0    ; containing a double bond in both beads
   7  8 	1      0.460    2800.0    ; containing a double bond in both beads
   8  9 	1      0.485    2800.0
   4 10 	1 	0.345	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
  10 11 	1      0.405    4400.0
  11 12 	1      0.460    2800.0    ; containing a double bond in both beads
  12 13 	1      0.460    2800.0    ; containing a double bond in both beads
  13 14 	1      0.485    2800.0

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	115.0	17.5
   2  3  5 	1	135.0	20.0
   4  3  5 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  4 10 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  5  6 	1	180.0	13.5 ; warning, analog to 1	180.0	13.5
   5  6  7 	1      135.0	8.0    ; second double bond results in different angle distribution
   6  7  8 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
   7  8  9 	1      135.0	8.0
   4 10 11 	1	180.0	13.5 ; warning, analog to 1	180.0	13.5
  10 11 12 	1      135.0	8.0    ; second double bond results in different angle distribution
  11 12 13 	1      150.0	6.0    ; three double bonds in a row seem to sample a broader distribution of angles with a tendency for the third doube bond to point in the opposite direction
  12 13 14 	1      135.0	8.0



;;;;;; Martini lipid topology for di-C22:6 ES (DDES), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname DDES -alhead 'S P' -allink 'E E' -altail 'DFFDD DFFDD'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model ether lipid phosphatidylserine (ES) lipid corresponding to atomistic C22:6(4c;7c;10c;13c;16c;19c) di-docosahexaenoic acid tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; CNO-PO4-ET1-D1A-D2A-D3A-D4A-D5A
;          |
;         ET2-D1B-D2B-D3B-D4B-D5B
;
;  1 - 2 - 3 - 5 - 6 - 7 - 8 - 9 
;          |
;          4 - 10- 11- 12- 13- 14
;
;@INSANE alhead=S P, allink=E E, altail=DDDDD DDDDD, alname=DDES, charge=-1.0
;@RESNTEST DDE==DDES if: atoms[0]==CNO
;@BEADS CNO PO4 ET1 ET2 D1A D2A D3A D4A D5A D1B D2B D3B D4B D5B 
;@BONDS CNO-PO4 PO4-ET1 PO4-ET2 ET1-ET2 ET1-D1A D1A-D2A D2A-D3A D3A-D4A D4A-D5A ET2-D1B D1B-D2B D2B-D3B D3B-D4B D4B-D5B 
;

