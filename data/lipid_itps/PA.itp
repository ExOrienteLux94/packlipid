[moleculetype]
PA 	1

[atoms]
; id type   resnr     residu   atom    cgnr charge
1   SQ5n 	1 	PA 	COO 	1      -1.0
2   SC1  	1 	PA 	C1A 	2  	0
3   C1	 	1 	PA 	C2A 	3  	0
4   C1  	1 	PA 	C3A 	4  	0
5   C1  	1 	PA 	C4A 	5  	0
		
[bonds]
; i j funct length force.c.
1 2 	1 	0.325	4800.0
2 3 	1      0.420    4400.0    ; to be used between S to R beads
3 4 	1      0.490    2800.0    ; default R-R distance in the middle of an alkane chain
4 5 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
 1  2  3 	1	180.0	13.5
 2  3  4 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
 3  4  5 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference

