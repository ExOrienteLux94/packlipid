[moleculetype]
; molname      nrexcl
  DTPC          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     Q1   1  DTPC  NC3   1 	1.0
   2     Q5   1  DTPC  PO4   2 	-1.0
   3   SN4a   1  DTPC  GL1   3 	0
   4   SN4a   1  DTPC  GL2   4 	0
   5    SC1   1  DTPC  C1A   5 	0
   6     C1   1  DTPC  C2A   6 	0
   7    SC1   1  DTPC  C1B   7 	0
   8     C1   1  DTPC  C2B   8 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.404	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	2100.0    ; in glycerol using SN4a beads
   3  5 	1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   5  6 	1      0.430    4400.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   4  7 	1 	0.375	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   7  8 	1      0.430    4400.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	125.0	15.0
   2  3  5 	1	139.0	10.0
   4  3  5 	1	120.0	20.0 ; glycerol backbone to tail angle
   3  4  7 	1	120.0	20.0 ; glycerol backbone to tail angle
   3  5  6 	1	180.0	13.5
   4  7  8 	1	180.0	13.5



;;;;;; Martini lipid topology for di-C10:0 PC (DJPC), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname DJPC -alhead 'C P' -allink 'G G' -altail 'CC CC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model phosphatidylcholine (PC) lipid corresponding to atomistic C10:0 didecanoyl tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; NC3-PO4-GL1-C1A-C2A
;          |
;         GL2-C1B-C2B
;
;  1 - 2 - 3 - 5 - 6 
;          |
;          4 - 7 - 8 
;
;@INSANE alhead=C P, allink=G G, altail=CC CC, alname=DJPC, charge=0.0
;@RESNTEST DJP==DJPC if: atoms[0]==NC3
;@BEADS NC3 PO4 GL1 GL2 C1A C2A C1B C2B 
;@BONDS NC3-PO4 PO4-GL1 PO4-GL2 GL1-GL2 GL1-C1A C1A-C2A GL2-C1B C1B-C2B 
;

