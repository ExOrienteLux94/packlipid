[moleculetype]
; molname      nrexcl
  DUES          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1     P6   1  DUES  CNO   1 	0.0
   2     Q5   1  DUES  PO4   2 	-1.0
   3   SN3a   1  DUES  ET1   3 	0
   4   SN3a   1  DUES  ET2   4 	0
   5    SC1   1  DUES  C1A   5 	0
   6     C1   1  DUES  C2A   6 	0
   7     C1   1  DUES  C3A   7 	0
   8    SC1   1  DUES  C1B   8 	0
   9     C1   1  DUES  C2B   9 	0
  10     C1   1  DUES  C3B  10 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.388	8000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	3200.0 ; di-alkyl
   3  5 	1 	0.345	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   5  6 	1      0.420    4400.0    ; to be used between S to R beads
   6  7 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   4  8 	1 	0.345	4400.0    ; to distinguish shorter tail e.g. 16:0 from 18:0
   8  9 	1      0.420    4400.0    ; to be used between S to R beads
   9 10 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	115.0	17.5
   2  3  5 	1	135.0	20.0
   4  3  5 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  4  8 	1	120.0	20.0 ; ether backbone to tail angle validated on DHPCE and DMPCE
   3  5  6 	1	180.0	13.5 ; ether backbone to tail angle validated on DHPCE and DMPCE
   5  6  7 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference
   4  8  9 	1	180.0	13.5 ; ether backbone to tail angle validated on DHPCE and DMPCE
   8  9 10 	1      180.0	13.5   ; can be used with CBT dihedral potential, fitted from charmm36 reference



;;;;;; Martini lipid topology for di-C14:0 ES (DMES), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname DMES -alhead 'S P' -allink 'E E' -altail 'CCC CCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model ether lipid phosphatidylserine (ES) lipid corresponding to atomistic C14:0 dimyristoyl (DMES) tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; CNO-PO4-ET1-C1A-C2A-C3A
;          |
;         ET2-C1B-C2B-C3B
;
;  1 - 2 - 3 - 5 - 6 - 7 
;          |
;          4 - 8 - 9 - 10
;
;@INSANE alhead=S P, allink=E E, altail=CCC CCC, alname=DMES, charge=-1.0
;@RESNTEST DME==DMES if: atoms[0]==CNO
;@BEADS CNO PO4 ET1 ET2 C1A C2A C3A C1B C2B C3B 
;@BONDS CNO-PO4 PO4-ET1 PO4-ET2 ET1-ET2 ET1-C1A C1A-C2A C2A-C3A ET2-C1B C1B-C2B C2B-C3B 
;

