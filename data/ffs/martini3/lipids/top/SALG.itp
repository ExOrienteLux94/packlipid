;  i  j 	funct 	force.c.
   1  2 	1 	0.375	7000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	3200.0 ; alkenyl-acyl (plasmalogens)
