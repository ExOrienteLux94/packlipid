[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.388	8000.0
   2  3 	1 	0.440	1500.0
   2  4 	1 	0.524	1200.0
   3  4 	1 	0.315	3200.0 ; alkenyl-acyl (plasmalogens)
   3  5 	1 	0.450	2400.0    ; warning, analog to 1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
   5  6 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
   6  7 	1      0.475    2800.0    ; containing a double bond in one bead
   7  8 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
   8  9 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average
   4 10 	1 	0.420	2400.0    ; warning, analog to b_ET_C1_ether_5long
  10 11 	1      0.520    2800.0    ; to be used between R-R when one of the R beads is overmapping 5 carbons - consider if an alternative mapping is more appropiate!
  11 12 	1      0.475    2800.0    ; containing a double bond in one bead
  12 13 	1      0.475    2800.0    ; symmetric, same as b_C1_C4_mid
  13 14 	1      0.500    2800.0    ; at the end of the chain, internal conformations in AA reference results in a longer bond on average

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  3 	1	115.0	17.5
   2  3  5 	1	139.0	10.0
   4  3  5 	1	120.0	20.0 ; WARNING acyl-alkenyl (sn1/sn2) not validated
   3  4 10 	1	120.0	20.0 ; alkenyl-acyl plasmalogen backbone to tail angle validated on PLA18 (PC)
   3  5  6 	1	180.0	13.5 ; warning, analog to 1	180.0	13.5
   5  6  7 	1      180.0	13.5   ; across a beads containing a double bond in the first/third bead
   6  7  8 	1      140.0	10.0   ; one unsaturation
   7  8  9 	1      180.0	13.5   ; identical to a_C1_C1_C1 to improve transition temperatures of singly unsaturated lipids
   4 10 11 	1	180.0	13.5 ; warning, analog to a_ET_C1_C1_ether
  10 11 12 	1      180.0	13.5   ; across a beads containing a double bond in the first/third bead
  11 12 13 	1      140.0	10.0   ; one unsaturation
  12 13 14 	1      180.0	13.5   ; identical to a_C1_C1_C1 to improve transition temperatures of singly unsaturated lipids



;;;;;; Martini lipid topology for di-C24:1 LS (DNLS), generated using:
; The Martini lipid itp generator version M3.l01  Args are: -alname DNLS -alhead 'S P' -allink 'G L' -altail 'cCCDCC cCCDCC'
; WARNING: Autogenerated and not all lipid headgroup and tail combinations have been tested;
;          used with care and see K.B. Pedersen et al. 2024 for guidance.
;
; Description:
;   A general model plasmalogen phosphatidylserine (LS) lipid corresponding to atomistic C24:1(15c) di-nervonic acid tails.
; Parameterization:
;   This topology follows the standard Martini 3.0 lipid definitions and building block rules. 
;   Bonded parameters and mapping have been optimized as described in K.B. Pedersen et al. 2024.
; Reference(s): 
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*, 
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*, 
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3
; Created: 2024.07.12
;
; Molecular topology and mapping of indices:
; CNO-PO4-GL1-C1A-C2A-C3A-D4A-C5A-C6A
;          |
;         PL2-C1B-C2B-C3B-D4B-C5B-C6B
;
;  1 - 2 - 3 - 5 - 6 - 7 - 8 - 9 - 10
;          |
;          4 - 11- 12- 13- 14- 15- 16
;
;@INSANE alhead=S P, allink=G L, altail=CCCDCC CCCDCC, alname=DNLS, charge=-1.0
;@RESNTEST DNL==DNLS if: atoms[0]==CNO
;@BEADS CNO PO4 GL1 PL2 C1A C2A C3A D4A C5A C6A C1B C2B C3B D4B C5B C6B 
;@BONDS CNO-PO4 PO4-GL1 PO4-PL2 GL1-PL2 GL1-C1A C1A-C2A C2A-C3A C3A-D4A D4A-C5A C5A-C6A PL2-C1B C1B-C2B C2B-C3B C3B-D4B D4B-C5B C5B-C6B 
;

