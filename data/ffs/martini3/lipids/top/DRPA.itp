   5  6 	1      0.485    2800.0
   3  7 	1 	0.450	2400.0    ; attaching glycerol+ester beads to hydrocarbon tails
   7  8 	1      0.505    2800.0
   8  9 	1      0.485    2800.0

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  4 	1	139.0	10.0
