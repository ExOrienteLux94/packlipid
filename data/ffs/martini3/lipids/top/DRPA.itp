   9     C1   1  DRPA  C3B   9 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0.0_ffbonded_v2.itp)
;  i  j 	funct 	force.c.
   1  2 	1 	0.440	1500.0
   1  3 	1 	0.524	1200.0
