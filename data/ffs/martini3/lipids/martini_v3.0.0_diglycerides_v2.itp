;;;;;; Martini lipid topology for di-C18:1 DG (DODG), generated using:
;
; Molecular topology and mapping of indices:
;      OH-GL1-C1A-D2A-C3A-C4A
;          |
;         GL2-C1B-D2B-C3B-C4B
;
;      1 - 2 - 4 - 5 - 6 - 7 
;        \ |
;          3 - 8 - 9- 10- 11
;

[moleculetype]
; molname      nrexcl
  DODG          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge    (mass)
   1   TN6   1  DODG  COH   1 	0
   2  SN4a   1  DODG  GL1   2 	0
   3  SN4a   1  DODG  GL2   3 	0
   4    C1   1  DODG  C1A   4 	0
   5   C4h   1  DODG  D2A   5 	0
   6    C1   1  DODG  C3A   6 	0
   7    C1   1  DODG  C4A   7 	0
   8    C1   1  DODG  C1B   8 	0
   9   C4h   1  DODG  D2B   9 	0
  10    C1   1  DODG  C3B  10 	0
  11    C1   1  DODG  C4B  11 	0

[bonds]
;  i  j 	name 	(using named bondtypes from martini_v3.0_ffbonded.itp)
;  i  j 	funct 	force.c.
   1  2 	b_COH_GL_def
   1  3 	b_COH_GL_def_long
   2  3 	b_GL_GL_glyc
   2  4 	b_GL_C1_glyc_5long
   4  5 	b_C1_C4_mid_5long
   5  6 	b_C4_C1_mid
   6  7 	b_C1_C1_end
   3  8 	b_GL_C1_glyc_5long
   8  9 	b_C1_C4_mid_5long
   9 10 	b_C4_C1_mid
  10 11 	b_C1_C1_end

[angles]
;  i  j  k 	name 	(using named angletypes from martini_v3.0_ffbonded.itp)
;  i  j  k 	funct 	angle 	force.c.
   1  2  4 	a_COH_GL_C_def
   3  2  4 	a_GL_GL_C_glyc
   2  3  8 	a_GL_GL_C_glyc
   2  4  5 	a_GL_C1_C4_glyc
   4  5  6 	a_C1_C4_C1_def
   5  6  7 	a_C4_C1_C1_def
   3  8  9 	a_GL_C1_C4_glyc
   8  9 10 	a_C1_C4_C1_def
   9 10 11 	a_C4_C1_C1_def
   
